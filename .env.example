# compose.prod.yml 로 배포할 때 사용하는 환경변수 템플릿입니다.
# 이 파일을 .env 로 복사한 뒤 실제 값을 채웁니다. .env 는 커밋하지 않습니다.
#   cp .env.example .env

SPRING_PROFILES_ACTIVE=prod

# Compose 네트워크에서는 서비스 이름(mysql)이 호스트명입니다.
DB_URL=jdbc:mysql://mysql:3306/azasyu?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=azasyu
DB_PASSWORD=replace-with-a-strong-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-password

# openssl rand -base64 48 으로 생성 (32바이트 이상 필요)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 프론트엔드 오리진. 스킴과 포트까지 정확히 일치해야 하며 끝 슬래시는 넣지 않습니다.
APP_CORS_ALLOWED_ORIGINS=http://3.39.194.205,http://localhost:5173,http://localhost:3000
